# copy to .env (cp .env.example .env), the defaults work as they are

# model files, downloaded from Hugging Face at startup if missing
MODELS_DIR="VLMmodels"
MODEL_REPO="lmstudio-community/Qwen2.5-VL-3B-Instruct-GGUF"
MODEL_FILE="Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf"
MMPROJ_FILE="mmproj-model-f16.gguf"
# only needed for gated/private models
HF_TOKEN=""

LM_STUDIO_BASE_URL="http://localhost:1234/v1"
LM_STUDIO_MODEL="qwen2.5-vl-3b-instruct"
LM_STUDIO_TIMEOUT_S=120
LMS_CONTEXT_LENGTH=16384

VLM_TEMPERATURE=0.0
VLM_SEED=42
VLM_MAX_RETRIES=1
VLM_MAX_TOKENS=2048

LOGS_DIR="logs"

MAX_IMAGES=8
MAX_IMAGE_SIDE=1024
DESCRIPTION_MIN_CHARS=20
DESCRIPTION_MAX_CHARS=2000
MAX_CLAIMS=10

API_HOST="0.0.0.0"
API_PORT=8000
